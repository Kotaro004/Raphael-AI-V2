# Genera valores únicos. No compartas este archivo con secretos reales.
FLASK_SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_LARGO
RAPHAEL_USERNAME=tu_usuario
# Genera el hash con: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('tu_contrasena'))"
RAPHAEL_PASSWORD_HASH=REEMPLAZAR_POR_HASH_DE_CONTRASENA
RAPHAEL_COOKIE_SECURE=true
# Dominios permitidos separados por comas; configura el dominio real al desplegar.
RAPHAEL_TRUSTED_HOSTS=
RAPHAEL_ENV=development
# Número exacto de proxies inversos de confianza (0 en local; normalmente 1 con proxy local).
RAPHAEL_TRUSTED_PROXY_HOPS=0
# En desarrollo: memory://. En producción: redis:// o rediss:// con credenciales.
RAPHAEL_LIMITER_STORAGE=memory://

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_WEB_SEARCH_TOOL=web_search_20250305
FLASK_PORT=5000
